# ─────────────────────────────────────────────────────────────────────────────
# VREAP Crawler — environment variables
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Facebook session cookies ──────────────────────────────────────────────────
# Obtain these from your browser's DevTools (Application → Cookies →
# https://www.facebook.com) after logging in manually.
#
# c_user  – your numeric Facebook user ID
# xs      – the session token paired with c_user
#
FB_COOKIE_C_USER=your_numeric_user_id
FB_COOKIE_XS=your_xs_session_token

# ── Target Facebook Group ─────────────────────────────────────────────────────
# The full URL of the public group you want to scrape.
FB_GROUP_URL=https://www.facebook.com/groups/batdongsantphcm59

# ── Webhook ───────────────────────────────────────────────────────────────────
# Cloudflare Worker (or any HTTP endpoint) that receives the scraped data.
# The crawler will POST the JSON array to this URL after the run completes.
WEBHOOK_URL=https://your-worker.your-subdomain.workers.dev/ingest

# ── Optional: path to a cookies JSON file ────────────────────────────────────
# If set, cookies are loaded from this file instead of the FB_COOKIE_* vars.
# The file must follow the Playwright / Puppeteer cookie format (see
# cookies.json.example for the expected schema).
# COOKIES_FILE=./cookies.json

# ── Optional: Webshare.io proxy API key ───────────────────────────────────────
# When set, the crawler fetches the proxy list from Webshare and rotates
# through them automatically.  Obtain your key at https://proxy.webshare.io/
# WEBSHARE_API_KEY=your_webshare_api_key
